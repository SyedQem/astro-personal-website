---
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { Nav } from "@/components/Nav";
import { CustomCursor } from "@/components/CustomCursor";
import BgPattern from "@/components/BgPattern.astro";
import Footer from "@/components/Footer.astro";

const {
  title = "Qurb E Muhammad Syed — Backend & Systems",
  description = "Backend & systems-focused software engineering student building clean, performance-minded projects in Java, C++, Python, and SQL.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <slot name="head" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://kirbydoestech.dev/" />
    <meta property="og:image" content="https://kirbydoestech.dev/og.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kirbydoestech.dev/og.png" />

    <!-- Theme: default dark unless user explicitly chose light. Runs before paint to avoid FOUC,
         and re-applies after every view-transition swap so the .dark class survives navigation. -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem("theme");
            var isLight = stored === "light";
            document.documentElement.classList.toggle("dark", !isLight);
          } catch (_) {
            document.documentElement.classList.add("dark");
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Qurb E Muhammad Syed",
      "alternateName": ["Kirby", "KirbyDoesTech"],
      "url": "https://kirbydoestech.dev",
      "sameAs": [
        "https://github.com/SyedQem",
        "https://www.linkedin.com/in/qems"
      ]
    })} />

    <ClientRouter />
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">
    <!-- Background layers: CSS pattern + soft top color glow + noise -->
    <BgPattern variant="grid" mask="fade-out" size={48} />
    <div class="bg-top-glow" aria-hidden="true" transition:persist></div>
    <div class="bg-noise" aria-hidden="true" transition:persist></div>

    <Nav currentPath={currentPath} client:load transition:persist />

    <!-- Optional decorative cursor (desktop only, idle hydration) -->
    <CustomCursor client:idle transition:persist />

    <div class="pt-14">
      <slot />
    </div>

    <Footer />

    <Analytics />
  </body>
</html>
