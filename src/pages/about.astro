---
import Layout from "@/layouts/Layout.astro";
import { AboutBento } from "@/components/AboutBento";
import { Badge } from "@/components/ui/badge";
import { Mail } from "lucide-react";
import { Github, Linkedin, Instagram } from "@/components/BrandIcons";
---

<Layout title="about — qurb e muhammad syed">
  <main class="relative z-10">
    <!-- INTRO -->
    <section class="mx-auto max-w-4xl px-6 pt-24 pb-16">
      <div class="font-mono text-xs uppercase tracking-widest text-primary">
        about
      </div>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight md:text-6xl">
        <span class="text-gradient">hey, i'm qurb.</span>
      </h1>

      <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted-foreground">
        <p>
          short version: i'm a fourth-year software engineering student at carleton
          who's way too into backend systems, clean architecture, and the kind of
          code that reads like english.
        </p>
        <p>
          longer version: i started programming because i wanted to build things,
          but stayed because i fell for the craft of it. how data flows through a
          system. why one abstraction holds up and another collapses. why the boring
          decisions usually win.
        </p>
        <p>
          right now i'm shipping personal projects, sharpening fundamentals
          (systems, networks, dsa), and looking for somewhere to do real engineering
          work. if that's you, <a
            href="mailto:williamarcesilaus@gmail.com"
            class="text-primary underline-offset-4 hover:underline"
            >drop me a line</a
          >.
        </p>
      </div>
    </section>

    <!-- BENTO ABOUT -->
    <section class="mx-auto max-w-6xl px-6 pb-20">
      <AboutBento client:visible />
    </section>

    <!-- CONNECT -->
    <section class="mx-auto max-w-4xl px-6 pb-24">
      <div class="font-mono text-xs uppercase tracking-widest text-primary">
        find me
      </div>
      <h2 class="mt-2 text-3xl font-semibold tracking-tight">where i live online</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <a
          href="mailto:williamarcesilaus@gmail.com"
          class="card-glow group flex items-center gap-4 rounded-xl border border-border bg-card/60 p-5 backdrop-blur-sm"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border text-primary">
            <Mail className="h-4 w-4" />
          </div>
          <div>
            <div class="font-medium text-foreground">email</div>
            <div class="font-mono text-xs text-muted-foreground">
              williamarcesilaus@gmail.com
            </div>
          </div>
        </a>

        <a
          href="https://github.com/SyedQem"
          target="_blank"
          rel="noopener noreferrer"
          class="card-glow group flex items-center gap-4 rounded-xl border border-border bg-card/60 p-5 backdrop-blur-sm"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border text-primary">
            <Github className="h-4 w-4" />
          </div>
          <div>
            <div class="font-medium text-foreground">github</div>
            <div class="font-mono text-xs text-muted-foreground">
              @syedqem
            </div>
          </div>
        </a>

        <a
          href="https://www.linkedin.com/in/qems"
          target="_blank"
          rel="noopener noreferrer"
          class="card-glow group flex items-center gap-4 rounded-xl border border-border bg-card/60 p-5 backdrop-blur-sm"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border text-primary">
            <Linkedin className="h-4 w-4" />
          </div>
          <div>
            <div class="font-medium text-foreground">linkedin</div>
            <div class="font-mono text-xs text-muted-foreground">
              in/qems
            </div>
          </div>
        </a>

        <a
          href="https://instagram.com/whoqurbae"
          target="_blank"
          rel="noopener noreferrer"
          class="card-glow group flex items-center gap-4 rounded-xl border border-border bg-card/60 p-5 backdrop-blur-sm"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border text-primary">
            <Instagram className="h-4 w-4" />
          </div>
          <div>
            <div class="font-medium text-foreground">instagram</div>
            <div class="font-mono text-xs text-muted-foreground">
              @whoqurbae
            </div>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout>
