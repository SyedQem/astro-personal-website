---
import Layout from "@/layouts/Layout.astro";
import { Hero } from "@/components/Hero";
import { ProjectCard } from "@/components/ProjectCard";
import { WhatImBuilding } from "@/components/WhatImBuilding";
import { Marquee } from "@/components/Marquee";
import { Reveal } from "@/components/Reveal";
import { MagneticButton } from "@/components/MagneticButton";
import { getCollection, type CollectionEntry } from "astro:content";

const allprojects: CollectionEntry<"projects">[] = await getCollection("projects");
const featuredProjects = allprojects.filter((p) => p.data.featured).slice(0, 4);

const marqueeItems = [
  "backend systems",
  "clean code",
  "boring tech",
  "small commits",
  "honest docs",
  "fast feedback loops",
  "taste > trends",
  "shipping > perfect",
];
---

<Layout title="qurb e muhammad syed — backend & systems">
  <main class="relative z-10">
    <Hero client:load />

    <!-- MARQUEE -->
    <section class="border-y border-border/60 bg-card/20 backdrop-blur-sm">
      <div class="mx-auto max-w-6xl">
        <Marquee items={marqueeItems} client:visible />
      </div>
    </section>

    <!-- BENTO: what i'm up to -->
    <section id="now" class="mx-auto max-w-6xl px-6 py-20">
      <Reveal client:visible>
        <div class="mb-10 flex items-end justify-between">
          <div>
            <div class="font-mono text-xs uppercase tracking-widest text-primary">
              01 · now
            </div>
            <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
              what i'm working on
            </h2>
          </div>
          <a href="/now" class="hidden font-mono text-xs text-muted-foreground hover:text-foreground md:inline">
            see full now →
          </a>
        </div>
      </Reveal>

      <WhatImBuilding client:visible />
    </section>

    <!-- FEATURED PROJECTS -->
    <section id="projects" class="mx-auto max-w-6xl px-6 py-20">
      <Reveal client:visible>
        <div class="mb-10">
          <div class="font-mono text-xs uppercase tracking-widest text-primary">
            02 · selected work
          </div>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
            things i've built
          </h2>
        </div>
      </Reveal>

      <div class="grid gap-5 md:grid-cols-2">
        {featuredProjects.map((p, i) => (
          <Reveal client:visible delay={i * 0.08}>
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              slug={p.slug}
              stack={p.data.stack}
              repo={p.data.repo}
              demo={p.data.demo}
              role={p.data.role}
              featured={p.data.featured}
            />
          </Reveal>
        ))}
      </div>

      <Reveal client:visible delay={0.16}>
        <div class="mt-12 flex justify-center">
          <MagneticButton
            href="/projects"
            className="group inline-flex h-11 items-center gap-2 rounded-lg border border-border bg-card/60 px-6 text-sm font-medium text-foreground backdrop-blur-sm transition-all hover:border-foreground/30 hover:bg-accent"
            client:visible
          >
            see all projects
            <span class="font-mono text-primary transition-transform group-hover:translate-x-0.5">
              →
            </span>
          </MagneticButton>
        </div>
      </Reveal>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-6 py-20">
      <Reveal client:visible>
        <div class="card-glow corner-brackets rounded-2xl border border-border bg-card/60 p-10 backdrop-blur-sm md:p-14">
          <div class="font-mono text-xs uppercase tracking-widest text-primary">
            03 · let's talk
          </div>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
            got a project, role, or wild idea?
          </h2>
          <p class="mt-3 max-w-2xl text-muted-foreground">
            i'm always down to chat about backend systems, internship opportunities, or
            just nerd out about clean code. find me below.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <MagneticButton
              href="mailto:williamarcesilaus@gmail.com"
              className="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition-all hover:bg-primary/90"
              client:visible
            >
              send an email →
            </MagneticButton>
            <MagneticButton
              href="https://www.linkedin.com/in/qems"
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex h-10 items-center gap-2 rounded-lg border border-border px-5 text-sm font-medium text-foreground transition-all hover:bg-accent"
              client:visible
            >
              linkedin
            </MagneticButton>
            <MagneticButton
              href="https://github.com/SyedQem"
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex h-10 items-center gap-2 rounded-lg border border-border px-5 text-sm font-medium text-foreground transition-all hover:bg-accent"
              client:visible
            >
              github
            </MagneticButton>
          </div>
        </div>
      </Reveal>
    </section>
  </main>
</Layout>
