---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";

const lastUpdated = "may 2026";
---

<Layout
  title="now — qurb e muhammad syed"
  description="what i'm doing right now — projects, learning, reading."
>
  <main class="relative z-10">
    <section class="mx-auto max-w-3xl px-6 pt-24 pb-24">
      <div class="font-mono text-xs uppercase tracking-widest text-primary">
        /now
      </div>
      <div class="mt-2 flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">
          <span class="text-gradient">what i'm up to</span>
        </h1>
        <Badge variant="mono">updated {lastUpdated}</Badge>
      </div>

      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        inspired by <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary underline-offset-4 hover:underline"
          >derek sivers' /now page idea</a
        >. a quick snapshot of what's actually filling my time, instead of a
        polished highlight reel.
      </p>

      <div class="mt-12 space-y-12">
        <section>
          <h2 class="font-mono text-xs uppercase tracking-widest text-primary">
            building
          </h2>
          <ul class="mt-4 space-y-3 text-muted-foreground">
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <a
                  href="/projects/vesper-works"
                  class="text-foreground underline-offset-4 hover:underline"
                  >vesper works</a
                > — a small design + frontend studio i'm starting with a few
                people i trust. just getting it off the ground.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <a
                  href="/projects/darwin"
                  class="text-foreground underline-offset-4 hover:underline"
                  >darwin</a
                > — the first product we're shipping out of vesper. a focused
                marketplace site, currently in active build.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">applykit</span> — a tool to make
                job applications less painful. shipping iterations weekly.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                this site, naturally. always tweaking.
              </span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="font-mono text-xs uppercase tracking-widest text-primary">
            learning
          </h2>
          <ul class="mt-4 space-y-3 text-muted-foreground">
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                motion design and interaction polish — framer-motion deep dives,
                the small details that make a page feel alive.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                typography systems — when restraint becomes a feature, not an
                absence.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                designing for taste — picking apart sites i admire (like
                <a
                  href="https://mubarakpiracha.xyz"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary underline-offset-4 hover:underline"
                  >mubarak's</a
                >) and figuring out *why* they work.
              </span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="font-mono text-xs uppercase tracking-widest text-primary">
            currently reading
          </h2>
          <ul class="mt-4 space-y-3 text-muted-foreground">
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">designing data-intensive applications</span>
                — kleppmann
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">a philosophy of software design</span>
                — ousterhout
              </span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="font-mono text-xs uppercase tracking-widest text-primary">
            recently read
          </h2>
          <ul class="mt-4 space-y-3 text-muted-foreground">
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">atomic habits</span> — james clear
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">the alchemist</span> — paulo coelho
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">the kite runner</span> — khaled hosseini
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">a thousand splendid suns</span> — khaled hosseini
              </span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                <span class="text-foreground">the pragmatic programmer</span> — hunt &amp; thomas
              </span>
            </li>
          </ul>
        </section>

        <section>
          <h2 class="font-mono text-xs uppercase tracking-widest text-primary">
            looking for
          </h2>
          <ul class="mt-4 space-y-3 text-muted-foreground">
            <li class="flex gap-3">
              <span class="text-primary">→</span>
              <span>
                summer 2026 internships and new-grad software engineering
                roles — especially product-facing, design-engineering, or
                frontend-leaning teams. <a
                  href="mailto:williamarcesilaus@gmail.com"
                  class="text-primary underline-offset-4 hover:underline"
                  >email me</a
                > if you're hiring.
              </span>
            </li>
          </ul>
        </section>
      </div>
    </section>
  </main>
</Layout>
