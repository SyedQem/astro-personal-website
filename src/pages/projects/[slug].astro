---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { ArrowLeft, ExternalLink } from "lucide-react";
import { Github } from "@/components/BrandIcons";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} — qurb e muhammad syed`}
  description={project.data.description}
>
  <head slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${project.data.title} — Qurb E Muhammad Syed`} />
    <meta property="og:description" content={project.data.description} />
    <meta
      property="og:image"
      content={`https://kirbydoestech.dev/og/project.png?title=${encodeURIComponent(project.data.title)}&stack=${encodeURIComponent(project.data.stack.join(","))}`}
    />
    <meta property="og:site_name" content="kirbydoestech.dev" />
    <meta
      property="og:url"
      content={`https://kirbydoestech.dev/projects/${project.slug}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${project.data.title} — Qurb E Muhammad Syed`} />
    <meta name="twitter:description" content={project.data.description} />
  </head>

  <main class="relative z-10 px-6 pt-24 pb-24">
    <article class="mx-auto max-w-3xl">
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        all projects
      </a>

      <header class="mt-8">
        {project.data.role && (
          <div class="font-mono text-xs uppercase tracking-widest text-primary">
            {project.data.role}
          </div>
        )}
        <h1 class="mt-2 text-4xl font-semibold tracking-tight md:text-5xl">
          {project.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          {project.data.description}
        </p>

        {project.data.stack.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {project.data.stack.map((t: string) => (
              <Badge variant="mono">{t}</Badge>
            ))}
          </div>
        )}

        {(project.data.repo || project.data.demo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {project.data.repo && (
              <a
                href={project.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 items-center gap-2 rounded-lg border border-border bg-card/60 px-4 text-sm text-foreground transition-all hover:bg-accent"
              >
                <Github className="h-3.5 w-3.5" />
                repo
              </a>
            )}
            {project.data.demo && (
              <a
                href={project.data.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-9 items-center gap-2 rounded-lg border border-border bg-card/60 px-4 text-sm text-foreground transition-all hover:bg-accent"
              >
                <ExternalLink className="h-3.5 w-3.5" />
                live demo
              </a>
            )}
          </div>
        )}
      </header>

      <hr class="my-10 border-border" />

      <div class="prose-clean">
        <Content />
      </div>
    </article>
  </main>
</Layout>
