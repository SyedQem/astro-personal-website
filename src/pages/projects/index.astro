---
import Layout from "@/layouts/Layout.astro";
import { ProjectCard } from "@/components/ProjectCard";
import { Reveal } from "@/components/Reveal";
import { getCollection, type CollectionEntry } from "astro:content";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
const prioritizedSlug = "applykit";

projects.sort((a, b) => {
  if (a.slug === prioritizedSlug) return -1;
  if (b.slug === prioritizedSlug) return 1;
  return 0;
});
---

<Layout title="projects — qurb e muhammad syed">
  <main class="relative z-10">
    <section class="mx-auto max-w-6xl px-6 pt-24 pb-12">
      <div class="font-mono text-xs uppercase tracking-widest text-primary">
        projects
      </div>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight md:text-5xl">
        <span class="text-gradient">things i've shipped</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-foreground">
        a working list of what i've built — finished, in-flight, or somewhere in between.
        click in for the writeups.
      </p>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-24">
      <div class="grid gap-5 md:grid-cols-2">
        {projects.map((p, i) => (
          <Reveal client:visible delay={i * 0.06}>
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              slug={p.slug}
              stack={p.data.stack}
              repo={p.data.repo}
              demo={p.data.demo}
              role={p.data.role}
              featured={p.data.featured}
            />
          </Reveal>
        ))}
      </div>
    </section>
  </main>
</Layout>
