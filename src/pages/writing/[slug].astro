---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { ArrowLeft } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title={`${post.data.title} — qurb e muhammad syed`}
  description={post.data.description}
>
  <main class="relative z-10 px-6 pt-24 pb-24">
    <article class="mx-auto max-w-2xl">
      <a
        href="/writing"
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        <ArrowLeft className="h-3.5 w-3.5" />
        all writing
      </a>

      <header class="mt-8">
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <time class="font-mono text-muted-foreground">
            {formatDate(post.data.date)}
          </time>
          {post.data.tags.map((t: string) => (
            <Badge variant="mono">{t}</Badge>
          ))}
        </div>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          {post.data.description}
        </p>
      </header>

      <hr class="my-10 border-border" />

      <div class="prose-clean">
        <Content />
      </div>
    </article>
  </main>
</Layout>
